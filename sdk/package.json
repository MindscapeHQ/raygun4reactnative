{
  "name": "raygun4reactnative",
  "title": "Raygun4reactnative",
  "version": "2.0.0",
  "description": "Raygun React Native SDK",
  "main": "dist/index.js",
  "typescript": {
    "definition": "dist/index.d.ts"
  },
  "typings": "dist/index.d.ts",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "android/build.gradle",
    "android/gradle.properties",
    "android/src",
    "ios",
    "!ios/RaygunNativeBridge.xcodeproj",
    "raygun4reactnative.podspec",
    "react-native.config.js"
  ],
  "scripts": {
    "eslint": "eslint src/**",
    "clean": "npx rimraf node_modules dist ../**/*.tgz ../demo/node_modules ../demo/dist ../demo/android/.gradle ../demo/android/app/build ../demo/ios/Pods",
    "prepare": "rimraf dist && tsc -p ./",
    "prebuild": "npx rimraf release",
    "prettier": "npx prettier --write **/*.js __mocks__/**/*.js **/*.ts **/*.tsx",
    "test": "jest"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MindscapeHQ/raygun4reactnative.git"
  },
  "keywords": [
    "react-native"
  ],
  "author": {
    "name": "Raygun",
    "email": "hello@raygun.com"
  },
  "license": "MIT",
  "licenseFilename": "LICENSE",
  "readmeFilename": "README.md",
  "peerDependencies": {
    "@react-native-async-storage/async-storage": "^1.13.0 || ^2.0.0 || ^3.0.0",
    "react": ">=19.1.0",
    "react-native": ">=0.81.0"
  },
  "engines": {
    "node": ">=20.19.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native/babel-preset": "^0.87.1",
    "@react-native/jest-preset": "^0.87.1",
    "@types/jest": "^29.5.14",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.7",
    "eslint": "^10.10.0",
    "eslint-plugin-react": "^7.37.5",
    "globals": "^16.2.0",
    "jest": "^29.7.0",
    "jest-fetch-mock": "^3.0.3",
    "mockdate": "^3.0.5",
    "prettier": "^3.9.8",
    "react": "^19.3.0",
    "react-native": "^0.87.1",
    "rimraf": "^6.0.1",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.34.0"
  },
  "overrides": {
    "eslint-plugin-react": {
      "eslint": "$eslint"
    }
  }
}
